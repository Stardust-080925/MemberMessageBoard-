@using MemberMessageBoard.Models
@model Message

@{
    ViewData["Title"] = "刪除留言確定";
}

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="card" style="width: 30rem;">
        <div class="card-body">
            <h5 class="card-title">@Model.Title</h5>
            <h6 class="card-subtitle mb-2 text-muted">@Model.CreatedAt</h6>
            <p class="card-text">@Model.Content</p>
            <img src="@Model.ImagePath" style="max-height:150px" />
        </div>
    </div>
    <br />
    <button type="submit" class="btn btn-danger">刪除</button>
</form>

<br />
<form asp-action="Index" method="get">
    <button type="submit" class="btn btn-light">回上一頁</button>
</form>